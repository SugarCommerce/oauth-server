{
    "name": "sugarcommerce/oauth-server",
    "version": "1.1.0",
    "description": "The authorization-server half of OAuth 2.1 for a remote MCP server: protected resource and authorization server metadata, Client ID Metadata Documents and dynamic registration, authorization code with S256 PKCE, resource-bound opaque tokens, rotating refresh tokens with reuse detection, and revocation. Storage is yours.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://github.com/sugarcommerce/oauth-server",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "keywords": [
        "oauth",
        "oauth2.1",
        "authorization-server",
        "mcp",
        "pkce",
        "rfc8414",
        "rfc9728",
        "rfc8707",
        "rfc7591",
        "rfc7009"
    ],
    "require": {
        "php": ">=8.5",
        "ext-mbstring": "*",
        "sugarcommerce/generate": "^1.0",
        "sugarcommerce/http-client": "^1.0",
        "sugarcommerce/oauth": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\OAuthServer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\OAuthServer\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../*",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/sugarcommerce/oauth-server/issues",
        "source": "https://github.com/sugarcommerce/oauth-server"
    }
}
